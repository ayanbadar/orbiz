# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings

# Database (hostname `db` inside Compose)
POSTGRES_DB=meraki
POSTGRES_USER=meraki
POSTGRES_PASSWORD=meraki
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://meraki:meraki@db:5432/meraki

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS (comma-separated origins). When DEBUG=True and this is empty, all origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
