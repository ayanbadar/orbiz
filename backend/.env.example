# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings

# Database (hostname `db` inside Compose)
POSTGRES_DB=orbiz
POSTGRES_USER=orbiz
POSTGRES_PASSWORD=orbiz
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://orbiz:orbiz@db:5432/orbiz

# Redis / Celery
REDIS_URL=redis://redis:6379/0
# Set True only for a local runserver when Redis is not available. Leave False in Docker.
USE_LOCMEM_CACHE=False
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS (comma-separated origins). When DEBUG=True and this is empty, all origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Auth emails. Console prints reset links during local development.
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Orbiz <noreply@orbiz.local>

# Channel3 (server-side only — never expose in VITE_*)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
