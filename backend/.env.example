# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings

# Database (hostname `db` inside Compose)
POSTGRES_DB=orbiz
POSTGRES_USER=orbiz
POSTGRES_PASSWORD=orbiz
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://orbiz:orbiz@db:5432/orbiz

# Redis / Celery
REDIS_URL=redis://redis:6379/0
# Set True only for a local runserver when Redis is not available. Leave False in Docker.
USE_LOCMEM_CACHE=False
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS (comma-separated origins). When DEBUG=True and this is empty, all origins are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Outbound email (auth, payment requests, receipts). Mail is sent by the Celery worker,
# so backend, celery_worker and celery_beat all read these (recreate them after edits:
# `docker compose up -d`). Keep each key once — duplicates resolve differently on the
# host (first wins) and in Docker (last wins).
FRONTEND_URL=http://localhost:5173
# Local default: print emails to the worker log instead of sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Real delivery (Gmail example). Needs 2-Step Verification and a 16-character App Password
# (https://myaccount.google.com/apppasswords) — not your account password. Use your own
# Gmail address as both user and sender. Other providers: change host/port/TLS only.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Orbiz <noreply@orbiz.local>

# Channel3 (server-side only — never expose in VITE_*)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com

# Orbiz AI (server-side only — never expose in VITE_*)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-5-mini
# low | medium | high | minimal | "" (drop the field, for non-reasoning models)
ASSISTANT_REASONING_EFFORT=low

# PayPal Sandbox (server-side only — never expose in VITE_*)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Optional override; default is https://api-m.sandbox.paypal.com when MODE=sandbox
PAYPAL_API_BASE=
# Comma-separated currencies the PayPal merchant account can take (orders in others are blocked).
PAYPAL_SUPPORTED_CURRENCIES=USD
# Who emails the buyer a payment request: orbiz (our SMTP; PayPal invoice is link-only) or
# paypal (PayPal's own invoice email — Sandbox never delivers it).
PAYPAL_INVOICE_DELIVERY=orbiz
# A checkout link older than this many hours is replaced by a fresh one before it is emailed.
PAYPAL_CHECKOUT_LINK_MAX_AGE_HOURS=24
# Emailing the same address the same payment link again is refused for this many seconds.
PAYMENT_EMAIL_COOLDOWN_SECONDS=120
# Email the store's members ("You got paid") when a PayPal payment lands.
NOTIFY_SELLER_ON_PAYMENT=True
